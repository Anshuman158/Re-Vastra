{
  "name": "revastra-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create revastra-db",
    "db:migrate": "wrangler d1 execute revastra-db --local --file=./src/db/schema.sql",
    "db:migrate:prod": "wrangler d1 execute revastra-db --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}